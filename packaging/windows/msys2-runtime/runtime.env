# Pins for the MSYS2 runtime DLL (msys-2.0.dll) bundled in the Windows installer.
# Sourced by compile-runtime.sh, package-windows.sh and the Windows installer CI check.
#
# The MSYS2 installer the package is built from (see fetch-msys2-installer.py) ships msys2-runtime 3.6.10, which
# carries 8fbd980844 ("Cygwin: open: Unlock fdtab before open_with_arch()") without its upstream fixes. Netdata
# then dies at startup with an access violation inside msys-2.0.dll. We build MSYS2's shipped commit plus the two
# upstream fixes (also in Cygwin 3.6.11). Drop this once an official MSYS2 runtime with them is bundled.

MSYS2_RUNTIME_REPO=https://github.com/msys2/msys2-runtime.git
MSYS2_RUNTIME_VERSION=3.6.10
MSYS2_RUNTIME_BASE_COMMIT=c770e1b9fa537fff9287c1fd40ebc84ac498fcb6

# Commit produced by applying the patches in this directory on top of the base commit with the committer identity
# below. It identifies the build: it is embedded in the DLL's version string and in the runtime's child-process
# handshake, so it must differ from the base commit.
MSYS2_RUNTIME_PATCHED_COMMIT=a39aebcbbe4cc37c3f259fe2fae1efb639041143
MSYS2_RUNTIME_COMMITTER_NAME='Netdata CI'
MSYS2_RUNTIME_COMMITTER_EMAIL='bot@netdata.cloud'
MSYS2_RUNTIME_COMMITTER_DATE='2026-10-05T00:00:00+0000'
