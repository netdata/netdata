#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# macOS package preinstall: stop a running Agent before the payload is
# replaced. Runs as root under installer(8); must be strictly
# non-interactive.

LABEL="com.github.netdata"

# bootout is asynchronous: it starts the teardown and returns. Wait for the
# label to actually disappear, or the payload gets replaced under a running
# daemon and postinstall's bootstrap fails with EIO.
if /bin/launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    /bin/launchctl bootout "system/${LABEL}" 2>/dev/null || true
    i=0
    while [ "${i}" -lt 60 ] && /bin/launchctl print "system/${LABEL}" >/dev/null 2>&1; do
        sleep 1
        i=$((i + 1))
    done
fi

exit 0
