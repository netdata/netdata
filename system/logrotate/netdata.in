@localstatedir_POST@/log/netdata/*.log {
	daily
	missingok
	rotate 14
	compress
	delaycompress
	notifempty
	sharedscripts
	postrotate
		if [ -d /run/systemd/system ] && systemctl --quiet is-active netdata.service &&
			{ systemctl kill --kill-whom=main --signal=HUP netdata.service 2>/dev/null ||
			  systemctl kill --kill-who=main --signal=HUP netdata.service 2>/dev/null; }; then
			:
		else
			/bin/kill -HUP `cat /run/netdata/netdata.pid 2>/dev/null` 2>/dev/null || true
		fi
	endscript
}
