{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Cachestat eBPF Collector",
  "description": "Collects page cache statistics using eBPF probes",
  "properties": {
    "enabled": {
      "type": "boolean",
      "title": "Enable collector",
      "description": "Enable or disable the cachestat eBPF collector",
      "default": true
    },
    "update_every": {
      "type": "integer",
      "title": "Update interval",
      "description": "Data collection interval in seconds",
      "default": 1,
      "minimum": 1
    },
    "apps": {
      "type": "boolean",
      "title": "Per-application metrics",
      "description": "Enable per-application process metrics collection",
      "default": false
    },
    "cgroups": {
      "type": "boolean",
      "title": "Per-cgroup metrics",
      "description": "Enable per-control-group metrics collection",
      "default": false
    },
    "per_core_stats": {
      "type": "boolean",
      "title": "Per-core statistics",
      "description": "Collect statistics per CPU core instead of aggregated",
      "default": false
    },
    "kernel_debugfs": {
      "type": "string",
      "title": "Kernel debugfs path",
      "description": "Path to kernel debugfs mount point for symbol resolution",
      "default": "/sys/kernel/debug"
    }
  },
  "required": [],
  "ui": {
    "sections": [
      {
        "name": "Basic Settings",
        "fields": ["enabled", "update_every"]
      },
      {
        "name": "Advanced",
        "fields": ["apps", "cgroups", "per_core_stats", "kernel_debugfs"]
      }
    ]
  }
}
