# OpenTelemetry Plugin Configuration
# Configures how Netdata ingests OpenTelemetry metrics, logs, and traces over
# OTLP/gRPC and OTLP/HTTP.
#
# To customize, run: edit-config otel.yaml
# Include only the fields you want to change — everything left out keeps its
# default. Parsing is strict: an unknown field, a malformed value, or a
# conflicting combination (such as a TLS certificate without its key) stops
# the plugin from starting.
#
# Settings resolve in this order: installed stock file < your otel.yaml copy
# < NETDATA_OTEL_CFG_* environment variables. Variable names mirror the
# option path (receivers.otlp.protocols.grpc.endpoint ->
# NETDATA_OTEL_CFG_RECEIVERS_OTLP_PROTOCOLS_GRPC_ENDPOINT); see the plugin
# README for the exact naming rules. Restart the Netdata Agent after
# changing this file or any of the variables.

receivers:
  otlp:
    # The two OTLP listeners. Keep at least one of them enabled. The
    # loopback defaults accept only local senders. To receive from other
    # hosts, bind a non-loopback address and protect the listener with TLS
    # and network access controls. Disable a listener that no sender uses.
    #
    # TLS: set cert_file and key_file together (PEM files).
    # client_ca_file enables mutual TLS: senders must present a client
    # certificate signed by this CA. Each listener has its own TLS settings.
    #
    # Older files configure the gRPC listener in an "endpoint:" section
    # (path, tls_cert_path, tls_key_path, tls_ca_cert_path). These names
    # still work and log a deprecation warning. If a file sets an option
    # under both names, the plugin uses the value under "receivers:".
    protocols:
      # OTLP/gRPC listener.
      grpc:
        enabled: true
        endpoint: "127.0.0.1:4317"
        tls:
          cert_file: null
          key_file: null
          client_ca_file: null

      # OTLP/HTTP listener. It is off by default. Set enabled to true to
      # receive OTLP/HTTP.
      http:
        enabled: false
        endpoint: "127.0.0.1:4318"
        tls:
          cert_file: null
          key_file: null
          client_ca_file: null

metrics:
  # Directory holding optional per-metric mapping files that shape how OTEL
  # metrics become Netdata charts. They load on top of the mappings built
  # into the plugin (user mappings win); an invalid file is logged and
  # skipped, it does not stop the plugin.
  chart_configs_dir: @configdir_POST@/otel.d/v1/metrics

  # Chart update interval in seconds (1–3600).
  interval_secs: 10

  # Seconds to wait after a metric's last data point before gap-filling.
  # When interval_secs is overridden and this is not, it auto-derives as
  # 5 * interval_secs. The three timing values must satisfy
  # interval < grace <= expiry — an invalid resolved timing logs a warning
  # and falls back to built-in defaults, so change them together.
  grace_period_secs: 60

  # Seconds without data after which a chart is removed.
  expiry_duration_secs: 900

  # Maximum number of new charts a single OTLP export request may create —
  # the guard against cardinality explosion from high-cardinality label
  # combinations. Points for charts beyond this budget are dropped (with a
  # warning); later requests get a fresh budget, so the total chart count
  # is not capped by this.
  max_new_charts_per_request: 100

# Root directory under which all OpenTelemetry log and trace data is stored:
# each signal gets its own subtree below it (for example .../logs and
# .../traces). Must be an absolute path. Note that write-ahead, index, and
# catalog files under this tree can push total disk usage above the
# retention caps, which count the retained data files only.
base_dir: @logdir_POST@/otel/v2

remote_storage:
  # Upload data to remote object storage, in addition to keeping it on local
  # disk (local retention still applies). One backend is shared by logs and
  # traces.
  enabled: false

  # NEVER put credentials in this file or in the URI below. Credentials are
  # read from the netdata process environment and the standard cloud
  # locations — for S3: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
  # ~/.aws/credentials, or an attached instance role (nothing to configure).
  # To pass environment variables to the netdata service, use a root-only
  # systemd EnvironmentFile.

  # Remote storage location, required when enabled is true. The scheme
  # selects the backend (fs, s3); non-secret backend options go in the query
  # string. Examples:
  #   fs:///var/lib/netdata/otel/remote
  #   s3://bucket/prefix?region=us-east-1
  #   s3://bucket/prefix?region=us-east-1&endpoint=https://minio.example:9000
  uri: "fs://@logdir_POST@/otel/v2/remote"

  # Data deleted from local disk by retention but still in remote storage is
  # downloaded back into a local cache (<base_dir>/remote-read) when a query
  # needs it. One cache serves logs and traces; a query needing more than it
  # holds fails with a narrow-the-range error. Cap for that cache:
  read_cache_max_size: "1GB"

auth:
  # Require senders to identify a tenant via the X-Scope-OrgID header on
  # either transport (gRPC metadata or HTTP header). This is tenant
  # selection, not user authentication — trust the header only
  # on a protected endpoint (TLS and network controls). When disabled, all
  # data belongs to a single "default" tenant. Applies to logs and traces;
  # metrics have no tenants.
  enabled: false

logs:
  rotation:
    # Incoming logs are appended to a current file; a new file starts when
    # any of these limits is reached. The "default" entry applies to every
    # tenant without its own entry below.
    default:
      max_file_size: "25MB"
      max_entries: 50000

    # Per-tenant overrides (any subset of the fields above):
    # my-tenant:
    #   max_file_size: "100MB"

  retention:
    # How much log data to keep on local disk; the oldest files are deleted
    # when any of these limits is exceeded. The "default" entry applies to
    # every tenant without its own entry below.
    default:
      max_files: 100000
      max_total_size: "1GB"
      max_age: "7 days"

    # Per-tenant overrides (any subset of the fields above):
    # my-tenant:
    #   max_age: "30 days"

traces:
  rotation:
    # Incoming spans are appended to a current file; a new file starts when
    # any of these limits is reached. The "default" entry applies to every
    # tenant without its own entry below.
    default:
      max_file_size: "25MB"
      max_entries: 50000

    # Per-tenant overrides (any subset of the fields above):
    # my-tenant:
    #   max_file_size: "100MB"

  retention:
    # How much trace data to keep on local disk; the oldest files are deleted
    # when any of these limits is exceeded. The "default" entry applies to
    # every tenant without its own entry below.
    default:
      max_files: 100000
      max_total_size: "1GB"
      max_age: "7 days"

    # Per-tenant overrides (any subset of the fields above):
    # my-tenant:
    #   max_age: "30 days"
