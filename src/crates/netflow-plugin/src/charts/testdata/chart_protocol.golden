CHART netdata.netflow.memory_tier_index_bytes '' 'Netflow Tier Index Memory Breakdown' 'bytes' 'memory' 'netdata.netflow.memory_tier_index_bytes' stacked 160504 10 'store_first'
DIMENSION row_storage 'row_storage' absolute 1 1 'type=float'
DIMENSION field_stores 'field_stores' absolute 1 1 'type=float'
DIMENSION flow_lookup 'flow_lookup' absolute 1 1 'type=float'
DIMENSION schema 'schema' absolute 1 1 'type=float'
DIMENSION index_keys 'index_keys' absolute 1 1 'type=float'
DIMENSION scratch_field_ids 'scratch_field_ids' absolute 1 1 'type=float'
BEGIN netdata.netflow.memory_resident_bytes 10000000
SET rss = 0
SET hwm = 0
SET rss_anon = 0
SET rss_file = 0
SET rss_shmem = 0
SET anon_huge_pages = 0
END 1700000010 0 1
BEGIN netdata.netflow.memory_resident_mapping_bytes 10000000
SET heap = 0
SET anon_other = 0
SET journal_raw = 0
SET journal_1m = 0
SET journal_5m = 0
SET journal_1h = 0
SET geoip_asn = 0
SET geoip_geo = 0
SET other_file = 0
SET shmem = 0
END 1700000010 0 1
BEGIN netdata.netflow.memory_allocator_bytes 10000000
SET heap_in_use = 0
SET heap_free = 0
SET heap_arena = 0
SET mmap_in_use = 0
SET releasable = 0
END 1700000010 0 1
BEGIN netdata.netflow.memory_accounted_bytes 10000000
SET facet_archived = 0
SET facet_active = 0
SET facet_active_contributions = 0
SET facet_published = 0
SET facet_archived_paths = 0
SET tier_indexes = 0
SET open_tiers = 0
SET geoip_asn = 0
SET geoip_geo = 0
SET unaccounted = 0
END 1700000010 0 1
BEGIN netdata.netflow.memory_tier_index_bytes 10000000
SET row_storage = 0
SET field_stores = 0
SET flow_lookup = 0
SET schema = 0
SET index_keys = 0
SET scratch_field_ids = 0
END 1700000010 0 1
