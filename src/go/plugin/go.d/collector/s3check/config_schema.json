{
  "jsonSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "S3 check collector configuration",
    "type": "object",
    "propertyNames": {
      "enum": [
        "name",
        "vnode",
        "update_every",
        "autodetection_retry",
        "mode",
        "mode_lifecycle",
        "mode_ceph_multisite",
        "mode_aws_replication"
      ]
    },
    "definitions": {
      "credentials": {
        "title": "Static credentials",
        "description": "Optional explicit credentials for this endpoint. Omit this object to use the AWS SDK default credential chain.",
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "access_key_id": {
            "title": "Access key ID",
            "description": "Use a go.d secret reference instead of plaintext.",
            "type": "string",
            "minLength": 1,
            "sensitive": true
          },
          "secret_access_key": {
            "title": "Secret access key",
            "description": "Use a go.d secret reference instead of plaintext.",
            "type": "string",
            "minLength": 1,
            "sensitive": true
          },
          "session_token": {
            "title": "Session token",
            "description": "Optional token for temporary credentials.",
            "type": "string",
            "sensitive": true
          }
        },
        "required": ["access_key_id", "secret_access_key"]
      },
      "connection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Display name",
            "description": "Optional bounded chart label. It does not affect durable ownership.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "endpoint": {
            "title": "S3 endpoint",
            "description": "Optional HTTP(S) service endpoint. Leave empty to use the AWS SDK endpoint for the region.",
            "type": "string"
          },
          "region": {
            "title": "Region",
            "description": "Signing region, for example us-east-1.",
            "type": "string",
            "minLength": 1
          },
          "bucket": {
            "title": "Probe bucket",
            "description": "Bucket used for owned probe objects.",
            "type": "string",
            "minLength": 1
          },
          "credentials": {"$ref": "#/definitions/credentials"},
          "assume_role": {
            "title": "Assume role",
            "description": "Optional role assumed independently for this endpoint.",
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "role_arn": {
                "title": "Role ARN",
                "type": "string",
                "minLength": 1
              },
              "external_id": {
                "title": "External ID",
                "type": "string",
                "sensitive": true
              }
            },
            "required": ["role_arn"]
          },
          "path_style": {
            "title": "Path-style addressing",
            "description": "Place the bucket in the request path. This is common for Ceph RGW and S3-compatible services.",
            "type": "boolean",
            "default": true
          },
          "timeout": {
            "title": "Request timeout",
            "description": "Maximum duration of one logical S3 call, for example 10s.",
            "type": "string",
            "default": "10s",
            "minLength": 2
          },
          "proxy_url": {
            "title": "Proxy URL",
            "description": "Optional HTTP proxy URL. Leave empty to use standard proxy environment variables.",
            "type": "string",
            "sensitive": true
          },
          "tls_skip_verify": {
            "title": "Skip TLS verification",
            "description": "Disable certificate and hostname verification. This is insecure.",
            "type": "boolean",
            "default": false
          },
          "tls_ca": {
            "title": "TLS CA bundle",
            "type": "string",
            "pattern": "^$|^/"
          },
          "tls_cert": {
            "title": "TLS client certificate",
            "type": "string",
            "pattern": "^$|^/"
          },
          "tls_key": {
            "title": "TLS client key",
            "type": "string",
            "pattern": "^$|^/",
            "sensitive": true
          }
        },
        "required": ["region", "bucket"],
        "dependencies": {
          "tls_cert": ["tls_key"],
          "tls_key": ["tls_cert"]
        }
      },
      "lifecycle_mode": {
        "title": "Lifecycle configuration",
        "description": "Create, read, and delete owned probe objects through one S3 endpoint.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "title": "Owned object prefix",
            "description": "Prefix reserved for this collector. It must end with a slash.",
            "type": "string",
            "default": "netdata-s3check/",
            "minLength": 2,
            "maxLength": 900,
            "pattern": "^[^/].*/$"
          },
          "source": {
            "title": "S3 connection",
            "allOf": [{"$ref": "#/definitions/connection"}]
          }
        },
        "required": ["source"]
      },
      "replication_mode": {
        "title": "Replication configuration",
        "description": "Create and delete owned probe objects at the source and verify their visibility at the destination.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "title": "Owned object prefix",
            "description": "Prefix reserved for this collector. It must end with a slash.",
            "type": "string",
            "default": "netdata-s3check/",
            "minLength": 2,
            "maxLength": 900,
            "pattern": "^[^/].*/$"
          },
          "source": {
            "title": "Source connection",
            "allOf": [{"$ref": "#/definitions/connection"}]
          },
          "destination": {
            "title": "Destination connection",
            "allOf": [{"$ref": "#/definitions/connection"}]
          },
          "write_objective": {
            "title": "Write visibility objective",
            "description": "Source PUT to verified destination visibility objective, for example 15m.",
            "type": "string",
            "default": "15m",
            "minLength": 2
          },
          "write_timeout": {
            "title": "Write visibility timeout",
            "description": "Maximum time to wait for destination visibility, for example 30m.",
            "type": "string",
            "default": "30m",
            "minLength": 2
          },
          "delete_objective": {
            "title": "Delete visibility objective",
            "description": "Source delete to destination current-object invisibility objective, for example 5m.",
            "type": "string",
            "default": "5m",
            "minLength": 2
          },
          "delete_timeout": {
            "title": "Delete visibility timeout",
            "description": "Maximum time to wait for destination current-object invisibility, for example 15m.",
            "type": "string",
            "default": "15m",
            "minLength": 2
          }
        },
        "required": ["source", "destination"]
      }
    },
    "properties": {
      "update_every": {
        "title": "Update every",
        "description": "Probe polling interval in seconds.",
        "type": "integer",
        "minimum": 1,
        "default": 120
      },
      "autodetection_retry": {
        "title": "Detection retry",
        "description": "Seconds between retries after the initial provider check fails. Zero disables retries.",
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "mode": {
        "title": "Probe mode",
        "description": "Lifecycle checks one endpoint; replication modes measure one source-to-destination direction.",
        "type": "string",
        "enum": ["lifecycle", "ceph_multisite", "aws_replication"],
        "default": "lifecycle"
      },
      "vnode": {
        "title": "Virtual node",
        "description": "Optional Virtual Node associated with all charts from this job.",
        "type": "string"
      }
    },
    "dependencies": {
      "mode": {
        "oneOf": [
          {
            "title": "Lifecycle",
            "properties": {
              "mode": {"const": "lifecycle"},
              "mode_lifecycle": {
                "title": "Lifecycle configuration",
                "allOf": [{"$ref": "#/definitions/lifecycle_mode"}]
              }
            },
            "required": ["mode_lifecycle"],
            "not": {
              "anyOf": [
                {"required": ["mode_ceph_multisite"]},
                {"required": ["mode_aws_replication"]}
              ]
            }
          },
          {
            "title": "Ceph multisite",
            "properties": {
              "mode": {"const": "ceph_multisite"},
              "mode_ceph_multisite": {
                "title": "Ceph multisite configuration",
                "allOf": [{"$ref": "#/definitions/replication_mode"}]
              }
            },
            "required": ["mode_ceph_multisite"],
            "not": {
              "anyOf": [
                {"required": ["mode_lifecycle"]},
                {"required": ["mode_aws_replication"]}
              ]
            }
          },
          {
            "title": "AWS replication",
            "properties": {
              "mode": {"const": "aws_replication"},
              "mode_aws_replication": {
                "title": "AWS replication configuration",
                "allOf": [{"$ref": "#/definitions/replication_mode"}]
              }
            },
            "required": ["mode_aws_replication"],
            "not": {
              "anyOf": [
                {"required": ["mode_lifecycle"]},
                {"required": ["mode_ceph_multisite"]}
              ]
            }
          }
        ]
      }
    },
    "required": ["mode"]
  },
  "uiSchema": {
    "uiOptions": {"fullPage": true},
    "ui:flavour": "tabs",
    "ui:options": {
      "tabs": [
        {
          "title": "Mode",
          "fields": ["mode", "mode_lifecycle", "mode_ceph_multisite", "mode_aws_replication"]
        },
        {
          "title": "Collection",
          "fields": ["update_every", "autodetection_retry"]
        },
        {
          "title": "Virtual Node",
          "fields": ["vnode"]
        }
      ]
    },
    "mode": {
      "ui:help": "Choose the check to run. Lifecycle checks one endpoint; Ceph multisite and AWS replication check one source-to-destination direction.",
      "ui:widget": "radio",
      "ui:options": {"inline": true}
    },
    "mode_lifecycle": {
      "source": {
        "ui:flavour": "tabs",
        "ui:options": {
          "tabs": [
            {"title": "Connection", "fields": ["endpoint", "region", "bucket", "path_style"]},
            {"title": "Authentication", "fields": ["credentials", "assume_role"]},
            {"title": "HTTP", "fields": ["timeout", "proxy_url"]},
            {"title": "TLS", "fields": ["tls_skip_verify", "tls_ca", "tls_cert", "tls_key"]},
            {"title": "Labels", "fields": ["name"]}
          ]
        },
        "endpoint": {"ui:placeholder": "https://s3.example.net"},
        "credentials": {
          "access_key_id": {"ui:widget": "password"},
          "secret_access_key": {"ui:widget": "password"},
          "session_token": {"ui:widget": "password"}
        },
        "assume_role": {"external_id": {"ui:widget": "password"}},
        "proxy_url": {"ui:widget": "password"},
        "tls_key": {"ui:widget": "password"}
      }
    },
    "mode_ceph_multisite": {
      "source": {
        "ui:flavour": "tabs",
        "ui:options": {
          "tabs": [
            {"title": "Connection", "fields": ["endpoint", "region", "bucket", "path_style"]},
            {"title": "Authentication", "fields": ["credentials", "assume_role"]},
            {"title": "HTTP", "fields": ["timeout", "proxy_url"]},
            {"title": "TLS", "fields": ["tls_skip_verify", "tls_ca", "tls_cert", "tls_key"]},
            {"title": "Labels", "fields": ["name"]}
          ]
        },
        "endpoint": {"ui:placeholder": "https://zone-a.example.net"},
        "credentials": {
          "access_key_id": {"ui:widget": "password"},
          "secret_access_key": {"ui:widget": "password"},
          "session_token": {"ui:widget": "password"}
        },
        "assume_role": {"external_id": {"ui:widget": "password"}},
        "proxy_url": {"ui:widget": "password"},
        "tls_key": {"ui:widget": "password"}
      },
      "destination": {
        "ui:flavour": "tabs",
        "ui:options": {
          "tabs": [
            {"title": "Connection", "fields": ["endpoint", "region", "bucket", "path_style"]},
            {"title": "Authentication", "fields": ["credentials", "assume_role"]},
            {"title": "HTTP", "fields": ["timeout", "proxy_url"]},
            {"title": "TLS", "fields": ["tls_skip_verify", "tls_ca", "tls_cert", "tls_key"]},
            {"title": "Labels", "fields": ["name"]}
          ]
        },
        "endpoint": {"ui:placeholder": "https://zone-b.example.net"},
        "credentials": {
          "access_key_id": {"ui:widget": "password"},
          "secret_access_key": {"ui:widget": "password"},
          "session_token": {"ui:widget": "password"}
        },
        "assume_role": {"external_id": {"ui:widget": "password"}},
        "proxy_url": {"ui:widget": "password"},
        "tls_key": {"ui:widget": "password"}
      }
    },
    "mode_aws_replication": {
      "source": {
        "ui:flavour": "tabs",
        "ui:options": {
          "tabs": [
            {"title": "Connection", "fields": ["endpoint", "region", "bucket", "path_style"]},
            {"title": "Authentication", "fields": ["credentials", "assume_role"]},
            {"title": "HTTP", "fields": ["timeout", "proxy_url"]},
            {"title": "TLS", "fields": ["tls_skip_verify", "tls_ca", "tls_cert", "tls_key"]},
            {"title": "Labels", "fields": ["name"]}
          ]
        },
        "endpoint": {"ui:placeholder": "Leave empty for the AWS SDK endpoint"},
        "credentials": {
          "access_key_id": {"ui:widget": "password"},
          "secret_access_key": {"ui:widget": "password"},
