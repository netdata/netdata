# Generated by chartgen from this template and the executable Redfish registry.
plugin_name: go.d.plugin
modules:
  - meta:
      id: collector-go.d.plugin-redfish
      plugin_name: go.d.plugin
      module_name: redfish
      monitored_instance:
        name: Redfish
        link: https://www.dmtf.org/standards/redfish
        icon_filename: hardware.svg
        categories:
          - data-collection.hardware-and-sensors
      keywords:
        - redfish
        - bmc
        - out-of-band
        - hardware
        - server
        - idrac
        - ilo
      related_resources:
        integrations:
          list: []
      info_provided_to_referring_integrations:
        description: ""
    overview:
      data_collection:
        metrics_description: |
          Monitor standard DMTF Redfish resources exposed by a baseboard management controller (BMC).

          The collector covers endpoint health, systems, chassis, managers, processors, memory, storage, drives, volumes,
          network adapters and ports, PCIe, power, cooling, environmental sensors, batteries, leak detection, firmware,
          and assemblies. It publishes:

          - per-component metrics and state charts;
          - complete one-level rollups with population/completeness, min/average/max, fixed histograms, and state counts;
          - deterministic ComputerSystem virtual nodes when `node_mode: system_vnodes` is selected.
        method_description: |
          The collector authenticates to the Redfish ServiceRoot over HTTP or HTTPS, traverses only its closed standard-resource
          registry, and follows same-origin links. It prefers session authentication in `auto` mode and falls back to HTTP Basic
          authentication when the endpoint does not support a usable session. Requests are bounded by the configured timeout,
          retry count, and concurrency.

          Collection is best-effort: one unreadable resource does not stop independently reachable resources. Missing current
          values produce gaps rather than zeroes. Complete membership scans obsolete removed components; partial scans retain
          prior membership evidence without replaying stale readings.
      supported_platforms:
        include: []
        exclude: []
      multi_instance: true
      additional_permissions:
        description: |
          A read-only Redfish account is normally required. No local elevated privileges are needed.
      default_behavior:
        auto_detection:
          description: |
            Endpoints are not automatically detected. Configure each endpoint through a static or DynCfg job.
        limits:
          description: |
            Detailed component charts are admitted atomically per logical owner and component family. The default cap is 100
            components per family; exceeding it suppresses that whole detail group while preserving complete one-level rollups.
            Set `charts.max_detailed_components_per_family: 0` for no configurable cap.

            Protocol response bounds, closed traversal registries, and request concurrency protect the Agent from malformed
            or hostile payloads.
        performance_impact:
          description: |
            The default interval is 60 seconds. BMCs are often slow and may serialize requests internally. The collector starts
            conservatively with three concurrent requests and uses the configured ceiling unless the ServiceRoot explicitly
            prohibits multiple HTTP requests, in which case it uses one. It does not probe or automatically change the job's
            cadence. The complete endpoint walk is also bounded by the configured `update_every`; when it cannot finish, the
            collector publishes independently completed data as partial and rotates unfinished member work across later cycles.
            Use a larger `update_every`, narrower `collect` pattern, or lower concurrency if the BMC becomes overloaded.
    setup:
      prerequisites:
        list:
          - title: Enable and authorize Redfish
            description: |
              Enable the BMC's Redfish service and create a least-privilege monitoring account that can read the desired systems,
              chassis, managers, sensors, and storage.
          - title: Establish network and TLS trust
            description: |
              Ensure the Netdata Agent can reach the BMC. Prefer HTTPS with a trusted BMC certificate or configure `tls_ca`.
              `tls_skip_verify` is available for legacy/self-signed deployments but permits machine-in-the-middle attacks.
      configuration:
        file:
          name: go.d/redfish.conf
        options:
          description: |
            The following options apply per Redfish endpoint job. Credentials and private-key fields support Netdata secret
            references such as `${env:VARIABLE}` and `${file:/path}`.
          folding:
            title: Config options
            enabled: true
          list:
            - name: update_every
              group: Collection
              description: Data collection interval, in seconds.
              default_value: 60
              required: false
            - name: autodetection_retry
              group: Collection
              description: How often to retry the initial connection when the job fails to start, in seconds. Zero disables retries.
              default_value: 0
              required: false
            - name: url
              group: Target
              description: URL of the Redfish service. Accepts the origin or the full ServiceRoot path, over HTTP or HTTPS.
              default_value: ""
              required: true
            - name: node_mode
              group: Virtual Node
              description: "Where the charts appear: `local` publishes them on the collecting node, `system_vnodes` creates one virtual node per ComputerSystem."
              default_value: ""
              required: true
            - name: vnode
              group: Virtual Node
              description: Associates this job with a [Virtual Node](https://learn.netdata.cloud/docs/netdata-agent/configuration/organize-systems-metrics-and-alerts#virtual-nodes). Used only when the node mode is `local`.
              default_value: ""
              required: false
            - name: system_uri
              group: Target
              description: Restricts collection to one ComputerSystem, given as its exact resource URI on the same origin. Leave empty to collect every system.
              default_value: ""
              required: false
            - name: auth_method
              group: Authentication
              description: How to authenticate with the BMC. `auto` prefers a Redfish session and falls back to HTTP basic authentication.
              default_value: auto
              required: false
            - name: username
              group: Authentication
              description: Username of the BMC account. Required unless the authentication method is `none`.
              default_value: ""
              required: false
            - name: password
              group: Authentication
              description: Password of the BMC account. Required unless the authentication method is `none`.
              default_value: ""
              required: false
            - name: timeout
              group: HTTP
              description: HTTP request timeout, in seconds.
              default_value: 15
              required: false
            - name: retries
              group: HTTP
              description: Number of extra attempts for a request that fails with a transient error.
              default_value: 2
              required: false
            - name: max_concurrent_requests
              group: HTTP
              description: Maximum number of requests sent to this BMC at the same time. Lower it for controllers that rate-limit.
              default_value: 3
              required: false
            - name: proxy_url
              group: HTTP
              description: Proxy to use for the BMC requests. Leave empty to use the proxy settings from the environment.
              default_value: ""
              required: false
            - name: tls_ca
              group: TLS
              description: Path to a CA bundle file used to verify the BMC certificate. Leave empty to use the system trust store.
              default_value: ""
              required: false
            - name: tls_cert
              group: TLS
              description: Path to a client certificate file for mutual TLS. Requires a client key.
              default_value: ""
              required: false
            - name: tls_key
              group: TLS
              description: Path to the client key file for mutual TLS. Requires a client certificate.
              default_value: ""
              required: false
            - name: tls_skip_verify
              group: TLS
              description: Accept any certificate the BMC presents, including self-signed and expired ones.
              default_value: false
              required: false
            - name: collect
              group: Collection
              description: "Simple pattern selecting which component families to collect: base, compute, memory, thermal, power, storage, network, pcie, sensors, and firmware. Base is always collected."
              default_value: "*"
              required: false
            - name: charts.aggregates
              group: Cardinality
              description: Create one summary chart per component family, in addition to any detailed charts.
              default_value: true
              required: false
            - name: charts.details
              group: Cardinality
              description: Create one chart per individual component, such as each fan, sensor, or drive.
              default_value: true
              required: false
            - name: charts.max_detailed_components_per_family
              group: Cardinality
              description: Maximum number of components charted per family and per owner. Zero removes the limit.
              default_value: 100
              required: false
            - name: alarms.evaluate_thresholds
              group: Alerts
              description: Compare readings against the warning and critical thresholds the BMC reports, for components where the BMC reports no health state of its own. A health state reported by the BMC always wins.
              default_value: true
              required: false
            - name: host_scope_overrides
              group: Virtual Node
              description: Pins the generated virtual nodes to specific GUIDs or hostnames so they stay stable across BMC changes. Used only when the node mode is `system_vnodes`.
              default_value: "[]"
              required: false
        examples:
          folding:
            title: Config
            enabled: true
          list:
            - name: Central out-of-band monitoring with vnodes
              description: Create one deterministic Netdata vnode for each ComputerSystem exposed by the BMC.
              config: |
                jobs:
                  - name: bmc
                    url: https://192.0.2.1/redfish/v1/
                    node_mode: system_vnodes
                    username: monitoring
                    password: ${file:/etc/netdata/redfish-password}
                    tls_ca: /etc/netdata/redfish-ca.pem
            - name: In-band collection without duplicate nodes
              description: Publish the local server's BMC metrics on the existing Netdata node.
              config: |
                jobs:
                  - name: local-bmc
                    url: https://192.0.2.1/redfish/v1/
                    node_mode: local
                    system_uri: /redfish/v1/Systems/1
                    username: monitoring
                    password: ${file:/etc/netdata/redfish-password}
    troubleshooting:
      problems:
        list:
          - name: The endpoint check fails
            description: |
              Verify the ServiceRoot URL, reachability, account permissions, authentication mode, proxy policy, and TLS trust.
              `tls_skip_verify: true` can diagnose certificate problems but is not a secure permanent fix.
          - name: Collection takes close to or longer than the interval
            description: |
              BMCs can be slow and frequently serialize work. Lower `max_concurrent_requests`, increase `timeout` only when
              responses genuinely need it, increase `update_every`, or narrow `collect`.
          - name: Detailed charts are absent but aggregates exist
            description: |
              The component-family population exceeded `charts.max_detailed_components_per_family`, or `charts.details` is false.
              The gate is atomic: the collector never selects an arbitrary subset that would break continuity.
          - name: The same endpoint appears through more than one collector owner
            description: |
              Deterministic Redfish vnode GUIDs preserve identity but do not elect one collector. Differently named jobs and
              collectors on different Agents can still poll and publish the same endpoint concurrently, which duplicates metrics
              and creates a vnode identity conflict. Assign one active owner for each endpoint when using `system_vnodes`, or use
              deliberate `local` placement when the endpoint data should stay on separate collector nodes.
          - name: A standard resource is missing or incomplete
            description: |
              Initial compatibility evidence covers DMTF 2026.1 public schema types and embedded redundancy/leak-detection
              shapes, sanitized Dell- and HPE-derived payload shapes, a modern standalone Sensor shape, and synthetic protocol
              faults. Unauthenticated ServiceRoot reachability was exercised on three lab BMCs from Gigabyte and ASRock Rack;
              their models and firmware were not recorded, and no authenticated resource walk was exercised. Consequently, no
              vendor/model/firmware combination is claimed as live-validated, and the evidence does not prove authenticated
              sessions, throttling, or full-cycle timing. No Redfish emulator was run for this qualification. Start new hardware
              qualification with a Netdata nightly build, inspect partial-collection and compatibility diagnostics, and report
              the affected vendor, model, firmware, and sanitized payload shape when a standard resource is missing.
    alerts:
{{GENERATED_ALERTS}}
    metrics:
      folding:
        title: Metrics
        enabled: false
      description: |
        The closed executable registry emits standard Redfish contexts only when the endpoint exposes their source properties.
        The `redfish.*` namespace covers endpoint operations, resources, readings, and one-level rollups. Common hardware readings
        reuse `system.hw.sensor.*` contexts with `_collect_module=redfish`.
      availability: []
      dynamic_context_prefixes:
        - prefix: redfish.
          reason: The closed Redfish standard registry materializes optional resource, reading, and one-level rollup contexts by endpoint capability.
        - prefix: system.hw.sensor.
          reason: Standard Redfish temperature, voltage, fan, current, power, energy, humidity, and pressure readings reuse common hardware-sensor contexts.
      scopes:
        - name: endpoint
          description: Per Redfish endpoint job collection and log-routing state.
          labels:
            - name: endpoint_job
              description: Redfish job name.
            - name: endpoint_key
              description: Stable canonical endpoint key.
          metrics:
            - name: redfish.collection.status
              description: Overall endpoint collection result.
              unit: state
              chart_type: stacked
              dimensions:
                - name: success
                - name: partial
                - name: unavailable
            - name: redfish.collection.duration
              description: Endpoint collection-cycle duration.
              unit: seconds
              chart_type: line
              dimensions:
                - name: duration
            - name: redfish.collection.http_requests
              description: HTTP request attempts, retries, and redirects in the cycle.
              unit: requests/cycle
              chart_type: line
              dimensions:
                - name: started
                - name: retried
                - name: redirected
            - name: redfish.collection.resources
              description: Resource discovery and acquisition population.
              unit: resources
              chart_type: stacked
              dimensions:
                - name: discovered
                - name: readable
                - name: unreadable
                - name: unknown
        - name: resource or reading
          description: Per-component standard resource and normalized-reading charts, optionally attributed to generated ComputerSystem vnodes.
          labels:
            - name: resource_kind
              description: Normalized Redfish resource kind.
            - name: resource_name
              description: Current resource display name.
            - name: logical_owner_name
              description: Proven logical owner name.
            - name: component_family
              description: Cardinality and rollup component family.
          metrics:
            - name: redfish.system.health
              description: ComputerSystem health state.
              unit: state
              chart_type: stacked
              dimensions:
                - name: ok
                - name: warning
                - name: critical
                - name: unknown
        - name: one-level rollup
          description: |
            Complete child population aggregated only to its immediate approved rollup owner. The metrics below document the
            invariant and representative rollup shapes; additional `redfish.aggregate.*` summaries, fixed histograms, and state
            counts appear when the endpoint exposes their source capabilities.
          labels:
            - name: rollup_owner_kind
              description: Immediate rollup owner resource kind.
            - name: rollup_owner_name
              description: Current rollup owner display name.
            - name: component_family
              description: Aggregated component family.
          metrics:
            - name: redfish.aggregate.population
              description: Child population and acquisition coverage.
              unit: components
              chart_type: stacked
              dimensions:
                - name: total
                - name: readable
                - name: unreadable
                - name: unknown
                - name: histogram_eligible
                - name: histogram_ineligible
            - name: redfish.aggregate.completeness
              description: Collection and histogram completeness state.
              unit: state
              chart_type: stacked
              dimensions:
                - name: complete
                - name: incomplete
                - name: histogram_available
                - name: histogram_unavailable
            - name: redfish.aggregate.acquisition_state
              description: Child counts by acquisition state.
              unit: components
              chart_type: stacked
              dimensions:
                - name: readable
                - name: unreadable
                - name: unknown
            - name: redfish.aggregate.temperature
              description: Minimum, average, and maximum temperature across the immediate child population.
              unit: Celsius
              chart_type: line
              dimensions:
                - name: minimum
                - name: average
                - name: maximum
            - name: redfish.aggregate.temperature_distribution
              description: Fixed temperature histogram across the immediate child population.
              unit: components
              chart_type: heatmap
              dimensions:
                - name: lt_40
                - name: "40_50"
                - name: "50_60"
                - name: "60_70"
                - name: "70_80"
                - name: "80_85"
                - name: "85_90"
                - name: "90_95"
                - name: "95_100"
                - name: ge_100
            - name: redfish.aggregate.health
              description: Child counts by normalized health state.
              unit: components
              chart_type: stacked
              dimensions:
                - name: ok
                - name: warning
                - name: critical
                - name: unknown
            - name: redfish.aggregate.reading_alarm
              description: Child reading counts by normalized alarm state.
              unit: components
              chart_type: stacked
              dimensions:
                - name: clear
                - name: warning
                - name: cap
                - name: alarm
                - name: critical
                - name: emergency
                - name: fault
