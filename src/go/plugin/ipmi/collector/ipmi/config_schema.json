{
  "jsonSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "IPMI collector configuration.",
    "type": "object",
    "properties": {
      "update_every": {
        "title": "Update every",
        "description": "Data collection frequency in seconds.",
        "type": "integer",
        "minimum": 5,
        "default": 5
      },
      "driver": {
        "title": "Driver",
        "description": "Use open for a local kernel device, lan for IPMI 1.5, or lanplus for IPMI 2.0.",
        "type": "string",
        "enum": [
          "open",
          "lan",
          "lanplus"
        ],
        "default": "open"
      },
      "timeout": {
        "title": "Timeout",
        "description": "Timeout for each IPMI command.",
        "type": "string",
        "default": "5s"
      },
      "collect_sel": {
        "title": "Collect SEL",
        "description": "Collect the System Event Log entry count.",
        "type": "boolean",
        "default": true
      }
    },
    "dependencies": {
      "driver": {
        "oneOf": [
          {
            "properties": {
              "driver": {
                "enum": [
                  "open"
                ]
              },
              "device": {
                "title": "Device number",
                "description": "Local OpenIPMI device number.",
                "type": "integer",
                "minimum": 0,
                "default": 0
              }
            }
          },
          {
            "properties": {
              "driver": {
                "enum": [
                  "lan",
                  "lanplus"
                ]
              },
              "hostname": {
                "title": "Hostname",
                "description": "Remote BMC hostname or IP address.",
                "type": "string"
              },
              "port": {
                "title": "Port",
                "description": "Remote BMC UDP port.",
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "default": 623
              },
              "username": {
                "title": "Username",
                "description": "Remote BMC account name. Leave empty for an anonymous account if supported by the BMC.",
                "type": "string"
              },
              "password": {
                "title": "Password",
                "description": "Remote BMC account password. Leave empty only if the account has no password.",
                "type": "string"
              },
              "vnode": {
                "title": "Virtual node",
                "description": "Existing virtual node associated with the remote BMC. Leave empty to attach measurements to this Agent.",
                "type": "string"
              }
            },
            "required": [
              "hostname"
            ]
          }
        ]
      }
    }
  },
  "uiSchema": {
    "password": {
      "ui:widget": "password"
    },
    "ui:flavour": "tabs",
    "ui:options": {
      "tabs": [
        {
          "title": "Connection",
          "fields": [
            "driver",
            "device",
            "hostname",
            "port",
            "username",
            "password"
          ]
        },
        {
          "title": "Collection",
          "fields": [
            "update_every",
            "timeout",
            "collect_sel"
          ]
        },
        {
          "title": "Virtual Node",
          "fields": [
            "vnode"
          ]
        }
      ]
    },
    "driver": {
      "ui:widget": "radio",
      "ui:options": {
        "inline": true
      }
    },
    "hostname": {
      "ui:placeholder": "bmc.example.com"
    }
  }
}
